{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "dimensions",
    "priority_feedback",
    "confidence"
  ],
  "properties": {
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "score",
          "confidence",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "priority_feedback": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "category",
          "original",
          "improved",
          "explanation"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "improved": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          }
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "abstain_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
