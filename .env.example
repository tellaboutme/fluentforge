# Copy to .env only if you need to override a default.
# A clean clone runs with no .env at all: SQLite, AI disabled, no Docker.

APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Default (omit this line): sqlite+pysqlite:///<repo>/local-data/fluentforge.db
# PostgreSQL (requires `make up`):
# DATABASE_URL=postgresql+psycopg://fluentforge:fluentforge@localhost:5432/fluentforge

# Optional infrastructure; unused until Milestone 3.
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=fluentforge
# S3_ACCESS_KEY=minio
# S3_SECRET_KEY=miniosecret

# REQUIRED in any shared or deployed environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=720
PASSWORD_MIN_LENGTH=10

# Core learning must work with these disabled. AI is an accelerator, not a dependency.
#
# AI_PROVIDER is one of:
#   disabled  no rubric judgement at all. Writing and mediation stay
#             provisional; everything else is unaffected. This is the path
#             every test suite runs against.
#   local     a model you run yourself, speaking the OpenAI chat-completions
#             shape (Ollama, vLLM, llama.cpp, LM Studio). The learner's text
#             never leaves your deployment. Set AI_BASE_URL to the runtime,
#             e.g. http://localhost:11434, and AI_MODEL to the model name.
#             No key is needed unless a gateway in front of it wants one.
#   cloud     a hosted model. Requires AI_API_KEY.
#
# Both `local` and `cloud` abstain rather than fail: an unreachable model, a
# missing key, or an answer that does not satisfy the rubric schema leaves
# the learner with exactly the deterministic feedback they would have had.
AI_PROVIDER=disabled
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TUTOR_MODEL=
AI_EVALUATOR_MODEL=
SPEECH_PROVIDER=disabled
SPEECH_API_KEY=

# Raw learner audio is deleted after this many days.
RETENTION_RAW_AUDIO_DAYS=7
