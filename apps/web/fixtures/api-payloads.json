  "study_activity": {
    "activity_key": "study:study.a1.be_and_word_order",
    "activity_type": "study_task",
    "cefr_level": "A1",
    "estimated_minutes": 6,
    "examples": [
      "I am from Lisbon.",
      "The shops are closed on Sunday.",
      "She is not at home today.",
      "Are they your neighbours?"
    ],
    "explanation": "English needs a verb in almost every sentence, even when you are only\nsaying what something is. That verb is usually 'be': am, is, or are.\n\nThe order is subject, then verb, then the rest: \"My sister is a nurse.\"\nEnglish does not drop the verb the way many languages do, and it does\nnot usually move the subject after the verb in a statement.\n\nTo make it negative, add 'not' after the verb: \"I am not ready.\"\nTo ask, put the verb first: \"Are you ready?\"",
    "items": [
      {
        "feature": "grammar.agreement.subject_verb",
        "feature_label": "Subject and verb agreement",
        "item_type": "choice",
        "key": "i1",
        "options": [
          "are",
          "is",
          "am",
          "be"
        ],
        "prompt": "My brothers ___ at university in Berlin."
      },
      {
        "feature": "grammar.word_order.question",
        "feature_label": "Question formation",
        "item_type": "choice",
        "key": "i2",
        "options": [
          "Are",
          "Is",
          "Do",
          "They are"
        ],
        "prompt": "___ your parents at home this evening?"
      },
      {
        "feature": "grammar.negation.form",
        "feature_label": "Negation",
        "item_type": "gap_fill",
        "key": "i3",
        "options": [],
        "prompt": "I ___ (not / be) hungry, thank you."
      },
      {
        "feature": "grammar.word_order.statement",
        "feature_label": "Word order in statements",
        "item_type": "choice",
        "key": "i4",
        "options": [
          "It is",
          "Is",
          "Is it",
          "Very cold is"
        ],
        "prompt": "___ very cold today."
      }
    ],
    "skill_key": "grammar.basic_clause",
    "title": "Saying who and what: the verb 'be'"
  },
