# Prettier does not read .gitignore, so build output has to be excluded here
# too. Without this the format step walks .next/ -- thousands of generated
# chunks -- which is slow and, worse, means a formatter could rewrite files
# nobody wrote.
.next/
out/
coverage/
playwright-report/
test-results/
node_modules/

